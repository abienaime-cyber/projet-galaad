  "narrative": {
    "northStar": "La pièce à conviction",
    "overview": "Le matcha et ses ustensiles sont présentés comme une marchandise saisie : posés sous un projecteur sur un fond d'acier, étiquetés, numérotés, consignés. Le noir porte la marque (en-tête, pied de page, sections de démonstration), l'acier bleuté porte la boutique, et un seul vert matcha acide désigne l'action, la sélection et le progrès.\n\nLa densité est celle d'une planche technique : grands titres condensés en capitales, petites mentions en mono pour les doses, prix, numéros et indications de défilement, filets de 1 px, angles droits partout. La profondeur vient des objets en 3D, jamais des surfaces. L'accueil se lit au défilement : sections épinglées, titres qui montent ligne à ligne, scènes 3D pilotées par le scroll, et tout reste lisible et complet sans mouvement.",
    "keyCharacteristics": [
      "Noir, acier bleuté, un seul vert matcha.",
      "Titres en Barlow Condensed 800, capitales, interlignage serré (0.82 à 0.95).",
      "Mentions techniques en Fragment Mono 13 px, chiffres tabulaires.",
      "Angles droits, filets de 1 px, aucune ombre de surface.",
      "Objets modélisés en 3D sur fond acier éclairé, rendu fixe en repli."
    ],
    "rules": [
      {
        "name": "The One Green Rule",
        "body": "Le vert matcha est la seule couleur d'accent. Il marque l'action, la sélection ou le progrès, jamais la décoration d'un texte courant sur fond clair : là, on prend matcha-ink.",
        "section": "colors"
      },
      {
        "name": "The Two Grounds Rule",
        "body": "Chaque zone est soit acier/papier avec texte encre, soit encre avec texte papier (marquée `data-theme=\"dark\"`). Les gris secondaires changent avec le fond : fog sur clair, fog-dark sur noir.",
        "section": "colors"
      },
      {
        "name": "The Stamp Rule",
        "body": "Barlow Condensed n'apparaît qu'en capitales et en gras (700 ou 800). Jamais pour un paragraphe.",
        "section": "typography"
      },
      {
        "name": "The Ledger Rule",
        "body": "Tout chiffre que le client compare (prix, grammes, tasses, scores) passe en mono tabulaire.",
        "section": "typography"
      },
      {
        "name": "The Spotlight Rule",
        "body": "Le relief appartient aux objets, pas aux cartes. Une surface se distingue par son fond ou son filet.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do garder un rayon de 0 sur tout élément d'interface.",
      "Do réserver le matcha à l'action principale, à la sélection et au progrès ; matcha-ink pour du vert en texte sur fond clair.",
      "Do écrire prix, doses, formats et numéros en Fragment Mono tabulaire.",
      "Do séparer par des filets de 1 px (line sur clair, line-dark sur noir) plutôt que par des ombres.",
      "Do poser les objets sur l'acier éclairé et prévoir leur rendu PNG en repli.",
      "Do conditionner chaque animation à `MOTION_OK` et fournir une version à plat, complète, en mouvement réduit.",
      "Do caler toute section épinglée sous l'en-tête (`PINNED_HEIGHT`, `pinStart`)."
    ],
    "donts": [
      "Don't introduire une deuxième couleur d'accent ni un dégradé coloré sur les surfaces d'interface.",
      "Don't arrondir les angles ni ajouter d'ombre portée à une carte ou un bouton ; l'ombre portée est réservée aux couches flottantes.",
      "Don't composer un paragraphe en Barlow Condensed ou un titre en bas de casse.",
      "Don't utiliser fog sur fond noir ni fog-dark sur fond clair.",
      "Don't laisser tourner une boucle de rendu 3D hors écran ou à l'arrêt."
    ]
  }

      "css": ".ds-header{display:flex;align-items:center;gap:12px;height:56px;padding:0 24px;background:var(--color-ink);color:var(--color-paper);} .ds-brand{font-family:var(--font-display);font-weight:800;text-transform:uppercase;font-size:27px;letter-spacing:0.01em;line-height:0.9;color:inherit;text-decoration:none;} .ds-nav{display:flex;margin-left:16px;} .ds-nav a{display:inline-flex;align-items:center;height:44px;padding:0 10px;font-family:var(--font-mono);font-size:13px;text-transform:uppercase;color:rgb(244 246 248 / 0.8);text-decoration:none;transition:color 150ms;} .ds-nav a:hover,.ds-cart:hover{color:var(--color-matcha);} .ds-nav a:focus-visible,.ds-cart:focus-visible{outline:2px solid var(--color-matcha);outline-offset:2px;} .ds-cart{position:relative;margin-left:auto;display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;color:var(--color-paper);transition:color 150ms;} .ds-badge{position:absolute;top:6px;right:2px;min-width:17px;height:17px;padding:0 4px;display:inline-flex;align-items:center;justify-content:center;background:var(--color-matcha);color:var(--color-ink);font-family:var(--font-mono);font-size:11px;font-variant-numeric:tabular-nums;}"

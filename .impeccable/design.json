      "css": ".ds-field{display:block;max-width:320px;} .ds-field-label{display:block;margin-bottom:8px;font-family:var(--font-sans);font-size:15px;font-weight:500;color:var(--color-ink);} .ds-field-box{position:relative;display:block;} .ds-input{width:100%;height:48px;padding:12px 48px 12px 16px;border:1px solid rgb(11 12 13 / 0.45);border-radius:0;background:var(--color-paper);color:var(--color-ink);font-family:var(--font-sans);font-size:17px;caret-color:var(--color-matcha-ink);transition:border-color 200ms,box-shadow 200ms;} .ds-input:focus{outline:none;border-color:var(--color-ink);box-shadow:0 0 0 3px var(--color-matcha);} .ds-unit{position:absolute;right:16px;top:50%;transform:translateY(-50%);font-family:var(--font-mono);font-size:13px;color:var(--color-fog);}"

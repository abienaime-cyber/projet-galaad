      "css": ".ds-tile{display:flex;flex-direction:column;width:260px;background:rgb(244 246 248 / 0.55);box-shadow:inset 0 0 0 1px var(--color-line);color:var(--color-ink);text-decoration:none;transition:background-color 200ms;} .ds-tile:hover{background:rgb(244 246 248 / 0.9);} .ds-tile:focus-visible{outline:2px solid var(--color-ink);outline-offset:2px;box-shadow:0 0 0 5px var(--color-matcha);} .ds-tile-img{display:block;aspect-ratio:1;background:radial-gradient(120% 90% at 50% 35%,#e6ebf0 0%,var(--color-steel) 45%,var(--color-steel-3) 100%);} .ds-tile-body{display:flex;flex-direction:column;gap:4px;padding:16px;} .ds-tile-name{font-family:var(--font-display);font-weight:800;text-transform:uppercase;font-size:26px;line-height:0.95;} .ds-tile-meta{font-family:var(--font-mono);font-size:13px;color:var(--color-fog);} .ds-tile-price{padding-top:12px;font-family:var(--font-mono);font-size:15px;font-variant-numeric:tabular-nums;}"

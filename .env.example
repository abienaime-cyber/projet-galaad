# Copier en .env.local (jamais commité) puis remplir.

# Supabase : Project Settings > API. La clé anon est publique, protégée par la RLS.
# Ne jamais mettre la clé service_role ici.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé de l'API Claude (console.anthropic.com). Lue uniquement côté serveur.
# Sans elle, le site fonctionne ; seuls le conseiller et la rédaction de fiches sont désactivés.
ANTHROPIC_API_KEY=

# URL publique du site (sitemap, robots.txt, image de partage). Inutile sur Vercel.
NEXT_PUBLIC_SITE_URL=

# Adresse de contact affichée sur la page Confidentialité (RGPD). À remplir avant une mise en ligne publique.
NEXT_PUBLIC_CONTACT_EMAIL=
